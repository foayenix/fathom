# ── Anthropic ──────────────────────────────────────────────────────────────
# Used server-side only by the Next.js API routes. The account behind this key
# needs a positive credit balance (console.anthropic.com → Plans & Billing).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (defaults to claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Supabase (accounts + cross-device sync) ─────────────────────────────────
# From your Supabase project → Settings → API. These are PUBLIC values, safe to
# expose in the browser; access is still protected by Row-Level Security.
# NOTE: NEXT_PUBLIC_* vars are baked in at BUILD time — set them before deploy,
# and redeploy after any change.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
